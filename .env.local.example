# Copy to .env.local for local development; set the same variables in the
# VPS environment for production. Never commit real values.

# --- Site -------------------------------------------------------------------
# Canonical URL used in SEO metadata, the sitemap and structured data.
NEXT_PUBLIC_SITE_URL=https://www.passionofhope.org

# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Only loaded in
# production builds; leave empty to disable analytics.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Form submissions ---------------------------------------------------------
# Folder where form submissions are appended as <source>.jsonl files
# (e.g. contact.jsonl). Relative paths resolve from the app directory.
# Default: data/submissions (git-ignored, and kept across deploys).
SUBMISSIONS_DIR=

# --- PayPal -----------------------------------------------------------------
# developer.paypal.com → Apps & Credentials. Use the Sandbox tab's
# "Default Application" for testing and a Live app for production.
# Without a client ID the donate page shows a "payments being set up" notice.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# "sandbox" (default) or "live".
PAYPAL_ENV=sandbox

# Optional. Billing plan for monthly gifts. If unset, a plan is created on
# first use and its ID is logged — copy that ID here to pin it.
PAYPAL_MONTHLY_PLAN_ID=

# Webhook ID from your PayPal app → Webhooks → Add Webhook, with the URL
# https://<your-domain>/api/paypal/webhook and these event types:
#   PAYMENT.CAPTURE.COMPLETED, PAYMENT.CAPTURE.DENIED,
#   PAYMENT.CAPTURE.REFUNDED, PAYMENT.CAPTURE.REVERSED,
#   BILLING.SUBSCRIPTION.ACTIVATED, BILLING.SUBSCRIPTION.CANCELLED,
#   BILLING.SUBSCRIPTION.SUSPENDED, BILLING.SUBSCRIPTION.EXPIRED,
#   BILLING.SUBSCRIPTION.PAYMENT.FAILED
# Sandbox and Live each need their own webhook (and ID).
PAYPAL_WEBHOOK_ID=
